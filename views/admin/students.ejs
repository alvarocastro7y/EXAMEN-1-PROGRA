<% layout("layouts/admin2") %>

<main class="main-content">
  <div class="container-fluid">

    <h3 class="mb-4">
      <a href="/admin/academic">
        <i class="fa fa-book me-2"></i>
        Gestión Académica
      </a>
      / Alumnos
    </h3>

    <div class="row">


        <div
            id="alertMessage"
            class="alert d-none"
            >
        </div>

      <!-- FORMULARIO -->
      <div class="col-lg-4 col-md-5 mb-4">

        <div class="card">

          <div class="card-header">

            <h6 class="mb-0" id="cardTitle">
              <i class="fa fa-plus me-2"></i>
              Nuevo Alumno
            </h6>

          </div>

          <div class="card-body">

            <form>

              <div class="mb-3">

                <label for="name" class="form-label">
                  Nombre
                </label>

                <input
                  type="text"
                  id="name"
                  class="form-control"
                  placeholder="Ingrese el nombre..."
                  required
                >

              </div>


              <div class="mb-3">

                <label for="lastname" class="form-label">
                  Apellido
                </label>

                <input
                  type="text"
                  id="lastname"
                  class="form-control"
                  placeholder="Ingrese el apellido..."
                  required
                >

              </div>


              <div class="mb-3">

                <label for="career" class="form-label">
                  Carrera
                </label>

                <input
                  type="text"
                  id="career"
                  class="form-control"
                  placeholder="Ingrese la carrera..."
                  required
                >

              </div>


              <div class="mb-3">

                <label for="age" class="form-label">
                  Edad
                </label>

                <input
                  type="number"
                  id="age"
                  name="age"
                  min="10"
                  max="100"
                  class="form-control"
                  placeholder="Ingrese la edad..."
                  required
                >

              </div>


              <input
                type="hidden"
                id="studentId"
              >

              

              <div class="d-flex justify-content-end gap-2">

                <button
                  class="btn btn-outline-secondary"
                  onclick="limpiar(event)"
                >
                  <i class="fa fa-refresh me-1"></i>
                  Limpiar
                </button>

                <button
                  type="submit"
                  class="btn btn-success"
                  id="btnGuardar"
                  onclick="agregar(event)"
                >
                  <i class="fa fa-save me-1"></i>
                  Guardar
                </button>

              </div>

            </form>

          </div>

        </div>

      </div>


      <!-- LISTADO -->
      <div class="col-lg-8 col-md-7 mb-4">

        <div class="card">

          <div class="card-header">

            <h6 class="mb-0">
              <i class="fa fa-list me-2"></i>
              Lista de Alumnos
            </h6>

          </div>


          <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

              <div class="text-muted">
                <i class="fa fa-graduation-cap me-1"></i>
                Alumnos registrados
              </div>

              <div>
                <button
                  class="btn btn-success"
                >
                  <i class="fa fa-plus"></i>
                  Agregar Registro
                </button>
              </div>

            </div>

            <!-- TABLE -->
            <div class="table-responsive">

              <table
                class="table table-striped table-hover"
                id="students"
              >

                <thead>

                  <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Carrera</th>
                    <th>Edad</th>
                    <th class="text-end">Acciones</th>
                  </tr>

                </thead>


                <tbody>

                  <% if (students && students.length > 0) { %>

                    <% for (const student of students) { %>

                      <tr>

                        <td>
                          <%= student.id %>
                        </td>

                        <td>
                          <%= student.nombre %>
                        </td>

                        <td>
                          <%= student.apellido %>
                        </td>

                        <td>
                          <%= student.carrera %>
                        </td>

                        <td>
                          <%= student.edad %>
                        </td>

                        <td class="text-end">

                          <button
                            class="btn btn-sm btn-outline-secondary me-1"
                            onclick="editar(<%= student.id %>, event)"
                          >
                            <i class="fa fa-edit"></i>
                            Editar
                          </button>

                          <button
                            class="btn btn-sm btn-outline-danger"
                            onclick="eliminar(<%= student.id %>, event)"
                          >
                            <i class="fa fa-trash"></i>
                            Eliminar
                          </button>

                        </td>

                      </tr>

                    <% } %>

                  <% } else { %>

                    <tr>

                      <td
                        colspan="6"
                        class="text-center text-muted py-4"
                      >
                        No se encontraron alumnos.
                      </td>

                    </tr>

                  <% } %>

                </tbody>

              </table>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>
</main>
<script>
    let studentRows = document.getElementById("students").children[1].children.length;

    function limpiar(event){
        event.preventDefault();
        document.getElementById("studentId").value = "";
        document.getElementById("name").value = "";
        document.getElementById("lastname").value = "";
        document.getElementById("career").value = "";
        document.getElementById("age").value = "";
        document.getElementById("cardTitle").innerHTML = "Nuevo Alumno";
    }

    function agregar(event){
        event.preventDefault();
        let studentId = document.getElementById("studentId").value;
        let name = document.getElementById("name").value;
        let lastname = document.getElementById("lastname").value;
        let career = document.getElementById("career").value;
        let age = document.getElementById("age").value;
        let studentTable = document.getElementById("students");

        if(name == "" || lastname == "" || career == "" || age == ""){
            alertMessage.classList.remove("d-none");
            alertMessage.classList.add("alert-danger");
            alertMessage.classList.remove("alert-success");
            alertMessage.innerHTML = "Debe completar todos los campos";
            return;
        }
        if(age <= 16  || age >= 100){
            alertMessage.classList.remove("d-none");
            alertMessage.classList.add("alert-danger");
            alertMessage.classList.remove("alert-success");
            alertMessage.innerHTML = "La edad debe estar entre 16 y 100 años";
            return;
        }

        if (studentId==""){
            let tr = document.createElement("TR");
            let td1 = document.createElement("TD");
            let td2 = document.createElement("TD");
            let td3 = document.createElement("TD");
            let td4 = document.createElement("TD");
            let td5 = document.createElement("TD");
            let td6 = document.createElement("TD");

            studentRows = studentRows + 1;
            td1.innerHTML = studentRows;
            td2.innerHTML = name;
            td3.innerHTML = lastname;
            td4.innerHTML = career;
            td5.innerHTML = age;
            td6.innerHTML = `<td class="text-end">

                          <button
                            class="btn btn-sm btn-outline-secondary me-1"
                            onclick="editar(${studentRows}, event)"
                          >
                            <i class="fa fa-edit"></i>
                            Editar
                          </button>

                          <button
                            class="btn btn-sm btn-outline-danger"
                            onclick="eliminar(${studentRows}, event)"
                          >
                            <i class="fa fa-trash"></i>
                            Eliminar
                          </button>

                        </td>`
            tr.appendChild(td1);
            tr.appendChild(td2);
            tr.appendChild(td3);
            tr.appendChild(td4);
            tr.appendChild(td5);
            tr.appendChild(td6);

            console.log(tr);

            studentTable.children[1].appendChild(tr);

            alertMessage.classList.remove("d-none");
            alertMessage.classList.remove("alert-danger");
            alertMessage.classList.add("alert-success");

            alertMessage.innerHTML = "Alumno registrado correctamente";


        } else{
            let tbody = studentTable.children[1];
            for(let tr of tbody.children){
                if(tr.children[0].innerHTML.trim() == studentId){
                    tr.children[1].innerHTML = name;
                    tr.children[2].innerHTML = lastname;
                    tr.children[3].innerHTML = career;
                    tr.children[4].innerHTML = age;
                    document.getElementById("studentId").value = "";
                    document.getElementById("name").value = "";
                    document.getElementById("lastname").value = "";
                    document.getElementById("career").value = "";
                    document.getElementById("age").value = "";
                    document.getElementById("cardTitle").innerHTML = "Nuevo Alumno";

                    alertMessage.classList.remove("d-none");
                    alertMessage.classList.remove("alert-danger");
                    alertMessage.classList.add("alert-success");

                    alertMessage.innerHTML = "Alumno actualizado correctamente";

                }
            }
        }
        setInterval(() => {
            alertMessage.classList.add("d-none");
        }, 5000);
    }

    function eliminar(id, event){
    let tr = event.currentTarget.parentElement.parentElement;
    tr.remove();
    }

    function editar(id, event){
    let tr = event.currentTarget.parentElement.parentElement;
    let idRow = tr.children[0].innerHTML;
    let name = tr.children[1].innerHTML;
    let lastname = tr.children[2].innerHTML;
    let career = tr.children[3].innerHTML;
    let age = tr.children[4].innerHTML;

    document.getElementById("studentId").value = id;
    document.getElementById("name").value = name.trim();
    document.getElementById("lastname").value = lastname.trim();
    document.getElementById("career").value = career.trim();
    document.getElementById("age").value = age.trim();
    document.getElementById("cardTitle").innerHTML = "Editar Alumno";
    }


</script>