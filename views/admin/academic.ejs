<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestión Académica | PrácticaLima</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7f8;
            color: #222;
        }

        /* HEADER */
        .navbar {
            height: 90px;
            background: #202427;
            display: flex;
            align-items: center;
            padding: 0 35px;
            color: white;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 28px;
            font-weight: bold;
            margin-right: 45px;
        }

        .logo-box {
            width: 50px;
            height: 50px;
            background: #159447;
            border-radius: 8px;
        }

        .logo .green {
            color: #159447;
        }

        .admin-badge {
            background: #6c757d;
            padding: 8px 15px;
            border-radius: 8px;
            font-size: 18px;
            font-weight: normal;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 35px;
            margin-left: 45px;
        }

        .nav-links a {
            color: #aaa;
            text-decoration: none;
            font-size: 18px;
            transition: 0.2s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: white;
        }

        .nav-links a.active {
            color: #159447;
            font-weight: bold;
        }

        .public-btn {
            margin-left: auto;
            color: white;
            text-decoration: none;
            border: 1px solid #ddd;
            border-radius: 7px;
            padding: 10px 18px;
        }

        /* CONTENIDO */
        .container {
            max-width: 1250px;
            margin: 0 auto;
            padding: 40px 30px 60px;
        }

        .breadcrumb {
            font-size: 18px;
            margin-bottom: 35px;
            color: #666;
        }

        .breadcrumb a {
            color: #1266d6;
            text-decoration: underline;
        }

        .breadcrumb span {
            margin: 0 8px;
        }

        .title-section {
            margin-bottom: 35px;
        }

        .title-section h1 {
            font-size: 38px;
            margin-bottom: 10px;
            color: #202427;
        }

        .title-section p {
            font-size: 18px;
            color: #777;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            background: white;
            border-radius: 14px;
            padding: 30px;
            min-height: 210px;
            border: 1px solid #e2e5e7;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
            transition: 0.2s;
            text-decoration: none;
            color: inherit;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.10);
            border-color: #159447;
        }

        .icon {
            width: 58px;
            height: 58px;
            border-radius: 12px;
            background: #e7f6ee;
            color: #159447;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .card h2 {
            font-size: 22px;
            margin-bottom: 10px;
            color: #202427;
        }

        .card p {
            color: #777;
            line-height: 1.5;
            font-size: 15px;
        }

        .card .arrow {
            display: block;
            color: #159447;
            font-weight: bold;
            margin-top: 18px;
        }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .nav-links {
                display: none;
            }
        }

        @media (max-width: 600px) {
            .cards {
                grid-template-columns: 1fr;
            }

            .navbar {
                padding: 0 15px;
            }

            .logo {
                margin-right: 10px;
            }

            .admin-badge {
                display: none;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <header class="navbar">

        <div class="logo">
            <div class="logo-box"></div>

            <span>
                Práctica<span class="green">Lima</span>
            </span>
        </div>

        <div class="admin-badge">
            Admin
        </div>

        <nav class="nav-links">

            <a href="/admin">
                Dashboard
            </a>

            <a href="/admin/academic" class="active">
                Semestres
            </a>

            <a href="/admin/districts">
                Distritos
            </a>

            <a href="/admin/careers">
                Carreras
            </a>

            <a href="/admin/skills">
                Habilidades
            </a>

            <a href="/admin/students">
                Estudiantes
            </a>

        </nav>

        <a href="/" class="public-btn">
            Sitio público
        </a>

    </header>


    <!-- CONTENIDO -->
    <main class="container">

        <div class="breadcrumb">
            <a href="/admin">Gestión Académica</a>
            <span>/</span>
            <strong>Gestión Académica</strong>
        </div>


        <section class="title-section">

            <h1>Gestión Académica</h1>

            <p>
                Administra la información académica de PrácticaLima.
                Selecciona una sección para comenzar.
            </p>

        </section>


        <section class="cards">

            <!-- SEMESTRES -->
            <a href="/admin/semesters" class="card">

                <div class="icon">
                    📚
                </div>

                <h2>Semestres</h2>

                <p>
                    Gestiona los semestres académicos disponibles
                    para los estudiantes.
                </p>

                <span class="arrow">
                    Administrar →
                </span>

            </a>


            <!-- DISTRITOS -->
            <a href="/admin/districts" class="card">

                <div class="icon">
                    📍
                </div>

                <h2>Distritos</h2>

                <p>
                    Administra los distritos disponibles para
                    las prácticas profesionales.
                </p>

                <span class="arrow">
                    Administrar →
                </span>

            </a>


            <!-- CARRERAS -->
            <a href="/admin/carrers" class="card">

                <div class="icon">
                    🎓
                </div>

                <h2>Carreras</h2>

                <p>
                    Gestiona las carreras profesionales
                    registradas en el sistema.
                </p>

                <span class="arrow">
                    Administrar →
                </span>

            </a>


            <!-- HABILIDADES -->
            <a href="/admin/skills" class="card">

                <div class="icon">
                    ⭐
                </div>

                <h2>Habilidades</h2>

                <p>
                    Administra las habilidades que pueden
                    asociarse a los estudiantes.
                </p>

                <span class="arrow">
                    Administrar →
                </span>

            </a>


            <!-- ESTUDIANTES -->
            <a href="/admin/students" class="card">

                <div class="icon">
                    👨‍🎓
                </div>

                <h2>Estudiantes</h2>

                <p>
                    Consulta y administra la información
                    académica de los estudiantes.
                </p>

                <span class="arrow">
                    Administrar →
                </span>

            </a>


            <!-- RESUMEN -->
            <a href="/admin" class="card">

                <div class="icon">
                    📊
                </div>

                <h2>Dashboard</h2>

                <p>
                    Regresa al panel principal de administración
                    y consulta el resumen del sistema.
                </p>

                <span class="arrow">
                    Ir al dashboard →
                </span>

            </a>

        </section>

    </main>

</body>
</html>
